{
  "description": "work-steps: contesto e protezione della modalità automatica, solo nei progetti che hanno un work (.work/)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wk\" hook session-start", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wk\" hook stop", "timeout": 10 }
        ]
      }
    ]
  }
}
